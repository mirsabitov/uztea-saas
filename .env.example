# Copy to .env and fill in real values. Never commit .env.

# --- Django ---
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=uztea.uz,www.uztea.uz,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://uztea.uz
SITE_BASE_URL=http://127.0.0.1:8000

# --- Database (PostgreSQL) ---
DB_ENGINE=django.db.backends.postgresql_psycopg2
POSTGRES_DB=uztea
POSTGRES_USER=uztea
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Email (UzTEA) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=UzTEA <info@uztea.uz>

# --- Email (MatchED Expo sender) ---
MATCHED_EXPO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
MATCHED_EXPO_EMAIL_HOST=
MATCHED_EXPO_EMAIL_PORT=587
MATCHED_EXPO_EMAIL_HOST_USER=
MATCHED_EXPO_EMAIL_HOST_PASSWORD=
MATCHED_EXPO_EMAIL_USE_TLS=True
MATCHED_EXPO_EMAIL_USE_SSL=False
MATCHED_EXPO_EMAIL_TIMEOUT=15
MATCHED_EXPO_DEFAULT_FROM_EMAIL=MatchedExpo <info@matchedexpo.com>

# --- Telegram notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Click ---
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
CLICK_API_KEY=
CLICK_TIN=
CLICK_IKPU_CODE=
CLICK_PACKAGE_CODE=

# --- Payme ---
PAYME_ENV=test
PAYME_CASHBOX_ID=
PAYME_SECRET_KEY=
PAYME_TEST_URL=https://checkout.test.paycom.uz
PAYME_PROD_URL=https://checkout.paycom.uz

# --- Atmos ---
ATMOS_BASE_URL=https://apigw.atmos.uz
ATMOS_CONSUMER_KEY=
ATMOS_CONSUMER_SECRET=
ATMOS_STORE_ID=
ATMOS_TERMINAL_ID=

# --- Eskiz SMS (workspace messages) ---
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
# ESKIZ_BASE_URL=https://notify.eskiz.uz/api

# --- Brevo (all UzTEA email goes through Brevo when these are set) ---
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
# BREVO_SMTP_HOST=smtp-relay.brevo.com
# BREVO_SMTP_PORT=587

# --- Certificates portal ---
CERTIFICATES_BASE_URL=https://certificates.uztea.uz
